# Google Sheet ID: the long string in the sheet URL between /d/ and /edit
SHEET_ID=
# Tab name holding the form responses
SHEET_TAB=Form Responses 1

# Service account credentials (from the JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value including the BEGIN/END lines; "\n" escapes are fine
GOOGLE_PRIVATE_KEY=

# Time zone for the "Last updated" footer
DISPLAY_TIMEZONE=America/New_York

# Set to 1 to render built-in sample data instead of reading the sheet
USE_SAMPLE_DATA=
